# Put these zones in the nginx http {} block. See the same-host example for
# rationale and certificate paths.
limit_req_zone $binary_remote_addr zone=kanami_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=kanami_callback:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=kanami_write:10m rate=10r/m;

upstream kanami_web_admin {
    # Replace this placeholder with the ONE private address configured as
    # WEB_ADMIN_HOST on the Kanami VM.
    server 192.168.50.10:8000;
    keepalive 8;
}

server {
    listen 80;
    server_name kanami.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name kanami.example.com;
    ssl_certificate /etc/letsencrypt/live/kanami.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kanami.example.com/privkey.pem;

    client_max_body_size 10m;
    # HSTS is intentionally disabled in this copy-paste example. First configure
    # DNS/TLS and complete HTTPS, OAuth and write-action smoke tests. Only then
    # uncomment it: browsers cache HSTS until max-age expires.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    location = / {
        return 302 /admin/;
    }

    location = /admin/login {
        limit_req zone=kanami_login burst=5 nodelay;
        include snippets/kanami-remote-web-admin-proxy.conf;
    }
    location = /admin/auth/discord/callback {
        limit_req zone=kanami_callback burst=10 nodelay;
        include snippets/kanami-remote-web-admin-proxy.conf;
    }
    location ^~ /admin/settings/ {
        limit_req zone=kanami_write burst=5 nodelay;
        include snippets/kanami-remote-web-admin-proxy.conf;
    }
    location /admin/ {
        include snippets/kanami-remote-web-admin-proxy.conf;
    }

    location / {
        return 404;
    }

    # Never add a route to TCP/8765 or any /control endpoint.
}

# Copy deploy/nginx/snippets/kanami-remote-web-admin-proxy.conf to
# /etc/nginx/snippets/kanami-remote-web-admin-proxy.conf. Its contents are:
# proxy_pass http://kanami_web_admin;
# proxy_http_version 1.1;
# proxy_set_header Connection "";
# proxy_set_header Host $host;
# proxy_set_header X-Forwarded-For "";
# proxy_set_header X-Forwarded-Proto "";
# proxy_set_header Forwarded "";
# proxy_connect_timeout 5s;
# proxy_send_timeout 30s;
# proxy_read_timeout 30s;
#
# Firewall on Kanami host MUST allow TCP/8000 only from reverse proxy IP.
