# Install as /etc/kanami/kanami-web-admin.env with owner root:kanami-web and 0640.
# This is a separate Web Admin environment. Never add DISCORD_TOKEN here.

# Web-specific secret: use a dedicated read-only PostgreSQL role.
DATABASE_URL=postgresql+asyncpg://kanami_web_readonly:replace_me@127.0.0.1:5432/discord_stats_prod

# Shared non-secret runtime context. Keep these aligned with the bot env.
DISCORD_GUILD_ID=123456789012345678
REPORT_TIMEZONE=UTC
VOICE_MIN_SESSION_SECONDS=10
VOICE_CHECKPOINT_INTERVAL_SECONDS=60

# Display-only mirror for /admin/system. The bot service is the only process
# that starts Game Tracking; these values do not enable tracking in Web Admin.
GAME_TRACKING_ENABLED=false
GAME_CONFIRM_INTERVAL_SECONDS=60

# Dedicated Discord OAuth confidential client for Web Admin.
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=8000
WEB_ADMIN_DISCORD_CLIENT_ID=123456789012345678
WEB_ADMIN_DISCORD_CLIENT_SECRET=replace_me
WEB_ADMIN_DISCORD_REDIRECT_URI=https://kanami.example.com/admin/auth/discord/callback
WEB_ADMIN_ALLOWED_USER_IDS=123456789012345678
WEB_ADMIN_COOKIE_SECURE=true
WEB_ADMIN_SESSION_LIFETIME_SECONDS=28800

# Optional fixed-purpose loopback Bot Control. This secret is not a Discord token.
# WEB_ADMIN_BOT_CONTROL_URL=http://127.0.0.1:8765
# WEB_ADMIN_BOT_CONTROL_SHARED_SECRET=replace_with_at_least_32_random_characters

LOG_LEVEL=INFO
