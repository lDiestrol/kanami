# Discord — required. Keep real credentials only in a local env file.
DISCORD_TOKEN=replace_me
DISCORD_GUILD_ID=123456789012345678

# Optional Discord features. Leave unset to disable.
# DISCORD_AUDIT_LOG_CHANNEL_ID=123456789012345678
# DISCORD_AUTOROLE_ID=123456789012345678
# DISCORD_ANNIVERSARY_CHANNEL_ID=123456789012345678
# DISCORD_RETURN_CHANNEL_ID=123456789012345678
# Optional Kanami hierarchy IDs. Purple/Gold allow viewing other member profiles.
# DISCORD_GUEST_ROLE_ID=123456789012345678
# DISCORD_INITIATED_ROLE_ID=123456789012345678
# DISCORD_GUARDIAN_ROLE_ID=123456789012345678
# DISCORD_PURPLE_ROLE_ID=123456789012345678
# DISCORD_GOLD_ROLE_ID=123456789012345678
# Optional consequence of PostgreSQL-backed Rules v1 acceptance.
# RULES_ACCEPTED_ROLE_ID=123456789012345678
MEMBER_RETURN_MIN_ABSENCE_SECONDS=86400

# Optional loopback control API for Web Admin bot-profile changes.
DISCORD_BOT_CONTROL_ENABLED=false
DISCORD_BOT_CONTROL_HOST=127.0.0.1
DISCORD_BOT_CONTROL_PORT=8765
# DISCORD_BOT_CONTROL_SHARED_SECRET=replace_with_at_least_32_random_characters

# PostgreSQL — required; SQLAlchemy asyncpg URL only.
DATABASE_URL=postgresql+asyncpg://kanami_app:replace_me@127.0.0.1:5432/discord_stats_prod

# Web Admin. Keep loopback for same-host proxy deployments. A remote proxy may
# use one explicit RFC1918/IPv6 ULA address only with the separate opt-in below.
WEB_ADMIN_HOST=127.0.0.1
# WEB_ADMIN_ALLOW_PRIVATE_BIND=false
WEB_ADMIN_PORT=8000
WEB_ADMIN_DISCORD_CLIENT_ID=123456789012345678
WEB_ADMIN_DISCORD_CLIENT_SECRET=replace_me
WEB_ADMIN_DISCORD_REDIRECT_URI=https://kanami.example.com/admin/auth/discord/callback
# Deny-by-default access policy: comma-separated positive Discord user IDs.
WEB_ADMIN_ALLOWED_USER_IDS=123456789012345678
# Production HTTPS must use true. Only loopback HTTP development may use false.
WEB_ADMIN_COOKIE_SECURE=true
WEB_ADMIN_SESSION_LIFETIME_SECONDS=28800
# Configure both values to enable the bot-profile page actions. Use the same
# dedicated secret in the bot process, but never give DISCORD_TOKEN to Web Admin.
# WEB_ADMIN_BOT_CONTROL_URL=http://127.0.0.1:8765
# WEB_ADMIN_BOT_CONTROL_SHARED_SECRET=replace_with_at_least_32_random_characters

# Reporting/timezone — valid IANA timezone name.
REPORT_TIMEZONE=UTC

# Voice statistics.
VOICE_MIN_SESSION_SECONDS=10
VOICE_CHECKPOINT_INTERVAL_SECONDS=60

# The bot process uses these values to start/configure Game Tracking. A separate
# Web Admin env copies the same values only so /admin/system can report reality;
# setting them in Web Admin does not start the tracker.
GAME_TRACKING_ENABLED=false
GAME_CONFIRM_INTERVAL_SECONDS=60

# Retention. Daily text aggregates are permanent. Audit retention is active;
# raw per-message/server-event collectors are not implemented, but their
# validated settings are reserved.
AUDIT_TRANSIENT_RETENTION_DAYS=90
RAW_MESSAGE_RETENTION_DAYS=90
SERVER_EVENT_RETENTION_DAYS=365

# Logging: CRITICAL, ERROR, WARNING, INFO or DEBUG.
LOG_LEVEL=INFO
